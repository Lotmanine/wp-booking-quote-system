    {"id":"a15f7732-d5bc-4db7-9dcc-c166c5ff9893","name":"Format Alert","type":"n8n-nodes-base.code","typeVersion":2,"position":[480,300],"parameters":{"mode":"runOnceForAllItems","jsCode":"const item = $input.first().json;\nconst run = item.execution || {};\nconst message = (item.workflow?.name || 'workflow') + ' failed at ' + (run.lastNodeExecuted || 'unknown node') + ': ' + (run.error?.message || 'no message');\nreturn [{ json: { source: 'n8n', message: message.slice(0, 400) } }];"}},
    {"id":"467b9fc3-2675-4541-a22a-7016f3c5eb34","name":"Send Telegram Alert","type":"n8n-nodes-base.telegram","typeVersion":1.2,"position":[720,180],"parameters":{"resource":"message","operation":"sendMessage","chatId":"={{ $env.QHS_TELEGRAM_CHAT_ID }}","text":"=Quillmoor demo alert: {{ $json.message }}","additionalFields":{"appendAttribution":false,"parse_mode":"HTML"}},"credentials":{"telegramApi":{"id":"f99abjVnlKf6t0e5","name":"Telegram Lead Bot"}},"onError":"continueRegularOutput","webhookId":"82236e7c-ad9f-4d53-a608-190ca6f59552"},
    {"id":"7a54ee70-135f-4dc0-81ea-f10db8f42a6b","name":"Prepare Alert","type":"n8n-nodes-base.code","typeVersion":2,"position":[720,420],"parameters":{"mode":"runOnceForAllItems","jsCode":"const item = $input.first().json;\nlet nonce = '';\nwhile (nonce.length < 32) { nonce += Math.floor(Math.random() * 16).toString(16); }\nreturn [{ json: { payload: JSON.stringify({ source: item.source, message: item.message }), ts: String(Math.floor(Date.now() / 1000)), nonce } }];"}},
