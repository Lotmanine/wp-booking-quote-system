    {"id":"bbcc8c79-3dfb-4614-9002-69461b1f9234","name":"Store Alert in WordPress","type":"n8n-nodes-base.httpRequest","typeVersion":4.4,"position":[1200,420],"parameters":{"method":"POST","url":"={{ $env.QHS_WP_URL }}/wp-json/qhs/v1/n8n/alert","sendHeaders":true,"headerParameters":{"parameters":[{"name":"X-QHS-Key-Id","value":"n8n"},{"name":"X-QHS-Timestamp","value":"={{ $json.ts }}"},{"name":"X-QHS-Nonce","value":"={{ $json.nonce }}"},{"name":"X-QHS-Signature","value":"=v1={{ $json.mac }}"}]},"sendBody":true,"contentType":"json","specifyBody":"json","jsonBody":"={{ JSON.stringify({ payload: $json.payload }) }}"},"retryOnFail":true,"maxTries":3,"waitBetweenTries":2000,"onError":"continueRegularOutput"}
