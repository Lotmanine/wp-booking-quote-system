    {"id":"45d5a8e2-a9d8-4fc3-8d40-1b8b102b3f29","name":"Parse Envelope","type":"n8n-nodes-base.code","typeVersion":2,"position":[460,300],"parameters":{"mode":"runOnceForAllItems","jsCode":"const input = $input.first().json;\nconst headers = input.headers || {};\nconst body = input.body || {};\nreturn [{ json: {\n  keyId: String(headers['x-qhs-key-id'] || ''),\n  ts: String(headers['x-qhs-timestamp'] || ''),\n  nonce: String(headers['x-qhs-nonce'] || ''),\n  signature: String(headers['x-qhs-signature'] || ''),\n  payload: typeof body.payload === 'string' ? body.payload : '',\n} }];"}},
    {"id":"3b96c428-9934-4a86-a64d-146f276f0a5b","name":"Compute Expected Signature","type":"n8n-nodes-base.crypto","typeVersion":1,"position":[680,300],"parameters":{"action":"hmac","type":"SHA256","value":"={{ $json.ts }}.{{ $json.nonce }}.{{ $json.payload }}","secret":"={{ $env.QHS_N8N_HMAC_SECRET }}","dataPropertyName":"expected","encoding":"hex"}},
    {"id":"4f912108-9912-479d-a56c-d9563a8fe3a9","name":"Verify Signature","type":"n8n-nodes-base.code","typeVersion":2,"position":[900,300],"parameters":{"mode":"runOnceForAllItems","jsCode":"const item = $input.first().json;\nconst given = item.signature;\nconst wanted = 'v1=' + item.expected;\n// Constant time: every character is compared whatever the first mismatch.\nlet diff = given.length ^ wanted.length;\nfor (let i = 0; i < wanted.length; i++) {\n  diff |= wanted.charCodeAt(i) ^ given.charCodeAt(i % (given.length || 1));\n}\nconst store = $getWorkflowStaticData('global');\nstore.nonces = store.nonces || {};\nconst now = Date.now();\nfor (const key of Object.keys(store.nonces)) {\n  if (store.nonces[key] < now) { delete store.nonces[key]; }\n}\nlet valid = diff === 0\n  && item.keyId === 'n8n'\n  && /^[0-9]+$/.test(item.ts)\n  && Math.abs(now / 1000 - Number(item.ts)) <= 300\n  && /^[a-f0-9]{32}$/.test(item.nonce)\n  && !store.nonces[item.nonce];\nlet data = {};\nif (valid) {\n  try { data = JSON.parse(item.payload); } catch (error) { valid = false; }\n}\nif (valid) { store.nonces[item.nonce] = now + 600000; }\nreturn [{ json: { valid, data } }];"}},
    {"id":"1acf6ad0-2228-4c32-ac76-c8b5408112f4","name":"Signature Valid?","type":"n8n-nodes-base.if","typeVersion":2.2,"position":[1120,300],"parameters":{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict"},"conditions":[{"leftValue":"={{ $json.valid }}","operator":{"type":"boolean","operation":"true","singleValue":true},"rightValue":""}],"combinator":"and"}}},
