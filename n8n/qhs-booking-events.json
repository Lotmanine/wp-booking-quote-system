    {"id":"0762ba30-4e6f-4578-a0b7-1751740fabea","name":"Route Event","type":"n8n-nodes-base.switch","typeVersion":3.2,"position":[1560,200],"parameters":{"rules":{"values":[{"outputKey":"dispatch","conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"loose"},"conditions":[{"leftValue":"={{ [\"booking.confirmed\", \"booking.rescheduled\"].includes($json.data.event) }}","operator":{"type":"boolean","operation":"true","singleValue":true},"rightValue":""}],"combinator":"and"}},{"outputKey":"release","conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict"},"conditions":[{"leftValue":"={{ $json.data.event }}","operator":{"type":"string","operation":"equals"},"rightValue":"booking.cancelled"}],"combinator":"and"}}]},"options":{"fallbackOutput":"extra","renameFallbackOutput":"CRM only"}}},
