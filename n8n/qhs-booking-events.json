    {"id":"9072d8fc-5728-4856-9b19-8974ba3b686d","name":"Release Staff","type":"n8n-nodes-base.httpRequest","typeVersion":4.4,"position":[1800,220],"parameters":{"method":"DELETE","url":"={{ $env.QHS_DISPATCH_URL }}/api/v1/assignments/{{ $json.data.booking_id }}","sendHeaders":true,"headerParameters":{"parameters":[{"name":"X-Api-Key","value":"={{ $env.QHS_DISPATCH_API_KEY }}"},{"name":"Accept","value":"application/json"}]}},"retryOnFail":true,"maxTries":3,"waitBetweenTries":3000},
    {"id":"ef8af43e-1149-4d04-b0a6-59d1eb84ab50","name":"Prepare CRM Sync","type":"n8n-nodes-base.code","typeVersion":2,"position":[2040,200],"parameters":{"mode":"runOnceForAllItems","jsCode":"const data = $('Verify Signature').first().json.data;\nlet nonce = '';\nwhile (nonce.length < 32) { nonce += Math.floor(Math.random() * 16).toString(16); }\nreturn [{ json: { payload: JSON.stringify({ event_id: data.event_id, booking_id: data.booking_id, event: data.event }), ts: String(Math.floor(Date.now() / 1000)), nonce } }];"}},
