{
	"$schema": "https://schemas.wp.org/wp/7.1/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"layout": {
			"contentSize": "760px",
			"wideSize": "1152px"
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"palette": [
				{ "slug": "canvas", "name": "Canvas", "color": "#ffffff" },
				{ "slug": "canvas-alt", "name": "Canvas alt", "color": "#f8fafc" },
				{ "slug": "ink", "name": "Ink", "color": "#0f172a" },
				{ "slug": "muted", "name": "Muted", "color": "#475569" },
				{ "slug": "subtle", "name": "Subtle", "color": "#64748b" },
				{ "slug": "line", "name": "Line", "color": "#e2e8f0" },
				{ "slug": "line-strong", "name": "Line strong", "color": "#cbd5e1" },
				{ "slug": "accent", "name": "Accent", "color": "#047857" },
				{ "slug": "accent-hover", "name": "Accent hover", "color": "#065f46" },
				{ "slug": "mark", "name": "Mark", "color": "#059669" },
				{ "slug": "accent-soft", "name": "Accent soft", "color": "#ecfdf5" }
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"fontFamilies": [
				{
					"slug": "body",
					"name": "Outfit",
					"fontFamily": "Outfit, ui-sans-serif, system-ui, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Outfit",
							"fontStyle": "normal",
							"fontWeight": "400 700",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/outfit-latin-var.woff2" ]
						}
					]
				},
				{
					"slug": "mono",
					"name": "JetBrains Mono",
					"fontFamily": "'JetBrains Mono', ui-monospace, monospace",
					"fontFace": [
						{
							"fontFamily": "JetBrains Mono",
							"fontStyle": "normal",
							"fontWeight": "400 500",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/jetbrains-mono-latin-var.woff2" ]
						}
					]
				}
			],
			"fontSizes": [
				{ "slug": "small", "name": "Small", "size": "0.875rem" },
				{ "slug": "medium", "name": "Medium", "size": "1.0625rem" },
				{ "slug": "large", "name": "Large", "size": "1.25rem" },
				{ "slug": "x-large", "name": "Extra large", "size": "2.25rem" }
			]
		},
		"spacing": {
			"units": [ "px", "rem", "%", "vw" ]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--canvas)",
			"text": "var(--wp--preset--color--ink)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "1rem",
			"lineHeight": "1.65"
		},
		"spacing": {
			"blockGap": "1.25rem"
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--body)",
					"fontWeight": "600",
					"lineHeight": "1.15",
					"letterSpacing": "-0.02em"
				},
				"color": {
					"text": "var(--wp--preset--color--ink)"
				}
			},
			"link": {
				"color": {
					"text": "var(--wp--preset--color--accent)"
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--accent)",
					"text": "#ffffff"
				},
				"border": {
					"radius": "12px"
				},
				"typography": {
					"fontWeight": "600"
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--accent-hover)",
						"text": "#ffffff"
					}
				}
			}
		}
	},
	"customTemplates": [
		{
			"name": "page-app",
			"title": "App page (no title)",
			"postTypes": [ "page" ]
		}
	],
	"templateParts": [
		{
			"name": "header",
			"title": "Header",
			"area": "header"
		},
		{
			"name": "footer",
			"title": "Footer",
			"area": "footer"
		}
	]
}
