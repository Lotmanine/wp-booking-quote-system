{
	"name": "lotmanine/quillmoor-booking",
	"description": "Quote, booking and dispatch plugin for the Quillmoor Home Services demo.",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"require": {
		"php": ">=8.3",
		"dompdf/dompdf": "3.1.6"
	},
	"require-dev": {
		"dealerdirect/phpcodesniffer-composer-installer": "1.2.0",
		"php-stubs/woocommerce-stubs": "v11.2.0",
		"php-stubs/wordpress-stubs": "v7.1.2",
		"phpstan/extension-installer": "1.4.3",
		"phpstan/phpstan": "2.3.4",
		"phpunit/phpunit": "9.6.38",
		"szepeviktor/phpstan-wordpress": "v2.0.4",
		"wp-coding-standards/wpcs": "3.4.1",
		"wp-phpunit/wp-phpunit": "7.1.3",
		"yoast/phpunit-polyfills": "4.0.0"
	},
	"autoload": {
		"psr-4": {
			"Quillmoor\\Booking\\": "src/"
		}
	},
	"config": {
		"sort-packages": true,
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true,
			"phpstan/extension-installer": true
		}
	},
	"scripts": {
		"lint": "phpcs",
		"analyse": "phpstan analyse --memory-limit=1G",
		"test": "phpunit"
	}
}
