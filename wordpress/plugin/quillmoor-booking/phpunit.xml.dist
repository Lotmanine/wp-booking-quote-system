<?xml version="1.0"?>
<phpunit bootstrap="tests/bootstrap.php" colors="true" convertDeprecationsToExceptions="false" failOnRisky="false">
	<testsuites>
		<testsuite name="integration">
			<directory suffix="Test.php">tests/Integration</directory>
		</testsuite>
	</testsuites>
	<php>
		<env name="WP_PHPUNIT__TESTS_CONFIG" value="tests/wp-tests-config.php"/>
	</php>
</phpunit>
