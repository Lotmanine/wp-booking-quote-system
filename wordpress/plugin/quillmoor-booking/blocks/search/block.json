{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "quillmoor/search",
	"title": "Search bar",
	"description": "Pill-shaped search for service, area, date and home size.",
	"category": "widgets",
	"textdomain": "quillmoor-booking",
	"supports": {
		"html": false
	},
	"style": "qhs-app",
	"viewScript": [
		"qhs-api",
		"file:./view.js"
	],
	"render": "file:./render.php",
	"attributes": {
		"compact": {
			"type": "boolean",
			"default": false
		}
	}
}
