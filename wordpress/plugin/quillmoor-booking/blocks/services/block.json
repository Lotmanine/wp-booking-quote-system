{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "quillmoor/services",
	"title": "Service results",
	"description": "Category chips, filters, sorting and service cards.",
	"category": "widgets",
	"textdomain": "quillmoor-booking",
	"supports": {
		"html": false
	},
	"style": "qhs-app",
	"viewScript": [
		"qhs-api",
		"file:./view.js"
	],
	"render": "file:./render.php",
	"attributes": {
		"mode": {
			"type": "string",
			"default": "browse"
		}
	}
}
