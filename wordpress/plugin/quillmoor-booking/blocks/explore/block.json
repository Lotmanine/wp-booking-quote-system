{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "quillmoor/explore",
	"title": "Explore",
	"description": "Category row, listing grid and map.",
	"category": "widgets",
	"textdomain": "quillmoor-booking",
	"attributes": {
		"section": {
			"type": "string",
			"default": "results"
		}
	},
	"supports": {
		"html": false,
		"multiple": true
	},
	"style": [
		"leaflet",
		"qhs-app"
	],
	"render": "file:./render.php",
	"viewScript": [
		"leaflet",
		"qhs-api",
		"file:./view.js"
	]
}
