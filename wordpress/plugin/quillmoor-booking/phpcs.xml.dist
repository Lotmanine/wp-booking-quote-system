<?xml version="1.0"?>
<ruleset name="Quillmoor">
	<description>WordPress Coding Standards for the plugin and theme.</description>
	<file>quillmoor-booking.php</file>
	<file>src</file>
	<file>blocks</file>
	<file>../../theme/quillmoor</file>
	<exclude-pattern>*/vendor/*</exclude-pattern>
	<arg name="extensions" value="php"/>
	<arg name="basepath" value="."/>
	<arg value="sp"/>
	<config name="minimum_supported_wp_version" value="7.0"/>
	<rule ref="WordPress-Core"/>
	<rule ref="WordPress-Extra"/>
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="quillmoor-booking"/>
				<element value="quillmoor"/>
			</property>
		</properties>
	</rule>
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="quillmoor"/>
			</property>
		</properties>
	</rule>
	<!-- PSR-4 file names are required by the Composer autoloader. -->
	<rule ref="WordPress.Files.FileName">
		<exclude-pattern>src/*</exclude-pattern>
		<exclude-pattern>*/patterns/*</exclude-pattern>
	</rule>
	<!-- Every query targets the plugin's own tables, which have no WordPress API or object cache layer. -->
	<rule ref="WordPress.DB.DirectDatabaseQuery">
		<exclude-pattern>src/*</exclude-pattern>
	</rule>
</ruleset>
